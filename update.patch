+
+    btn.disabled = true;
+    btn.textContent = '上傳中...';
+    status.textContent = '';
+
+    const formData = new FormData();
+    formData.append('question', q);
+    formData.append('answer', a);
+    formData.append('subject', s);
+    formData.append('topic', t);
+    if (imgFile) formData.append('file', imgFile);
+
+    try {
+        const res = await fetch(API + '/api/ingest', { method: 'POST', body: formData });
+        const data = await res.json();
+        if (data.status === 'success') {
+            status.style.color = "var(--apple-green)";
+            status.textContent = '✅ 上傳成功！已進入 Pending 區等待審核。';
+            setTimeout(() => {
+                closeUploadModal();
+                document.getElementById('ingestQuestion').value = '';
