+            }, 1500);
+        } else { throw new Error('上傳失敗'); }
+    } catch(e) {
+        status.style.color = "var(--apple-red)";
+        status.textContent = '⚠️ 上傳失敗，請檢查伺服器連線。';
+    } finally {
+        btn.disabled = false;
+        btn.textContent = '送出審核';
+    }
+}
