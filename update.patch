+            method: 'POST',
+            headers: {'Content-Type': 'application/json'},
+            body: JSON.stringify({ staging_id: stagingId })
+        });
+        const data = await res.json();
+        if (data.status === 'success') {
+            if (card) card.remove();
+            loadFlashcards(); // Refresh to update counts
+        }
+    } catch (e) {
+        alert("審核失敗");
+        if (card) card.style.opacity = '1';
+    }
+}
