// ── 頁籤切換 ──
function switchTab(t) {
    document.querySelectorAll('.tab-btn').forEach((b, i) => {
        b.classList.remove('active');
        if (t === 'chat' && i === 0) b.classList.add('active');
        if (t === 'flash' && i === 1) b.classList.add('active');
        if (t === 'timeline' && i === 2) b.classList.add('active');
    });

    document.getElementById('tab-chat').classList.toggle('active', t === 'chat');
    document.getElementById('tab-flash').classList.toggle('active', t === 'flash');
    const timelineTab = document.getElementById('tab-timeline');
    if (timelineTab) {
        timelineTab.classList.toggle('active', t === 'timeline');
        timelineTab.style.display = (t === 'timeline') ? 'block' : 'none';
    }

    // Hide chat tab specifically since it uses block by default
    document.getElementById('tab-chat').style.display = (t === 'chat') ? 'block' : 'none';
    document.getElementById('tab-flash').style.display = (t === 'flash') ? 'block' : 'none';

    if (t === 'flash') loadFlashcards();
}

async function loadTimeline() {
    try {
        const resp = await fetch(API + '/api/student/timeline');
        const data = await resp.json();
        const container = document.getElementById('timelineContainer');
        if (!data.timeline || data.timeline.length === 0) {
            container.innerHTML = '<div class="empty-state">🌱 尚無長週期脈絡，完成幾次對話後將自動繪製成長軌跡！</div>';
            return;
        }
        container.innerHTML = '';
        data.timeline.forEach(item => {
            const el = document.createElement('div');
            el.className = 'timeline-item';

            const isResolved = item.is_resolved === 1;
            const statusColor = isResolved ? 'var(--apple-green)' : 'var(--apple-orange)';
            const statusText = isResolved ? '✅ 已根治' : '⚠️ 潛在盲點';
            const dateStr = item.updated_at.substring(0, 10);

            el.innerHTML = `
                <div style="background: var(--card-bg); border-left: 4px solid ${statusColor}; padding: 16px; border-radius: 8px; box-shadow: var(--apple-shadow);">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <strong style="font-size: 1.1rem; color: var(--apple-text);">[${item.subject}] ${item.topic}</strong>
                        <span style="color: var(--apple-secondary); font-size: 0.85rem;">📅 ${dateStr}</span>
                    </div>
                    <div style="background: var(--input-bg); padding: 12px; border-radius: 8px; margin-bottom: 12px; color: var(--apple-text); line-height: 1.5;">
                        <strong>📝 盲點摘要：</strong><br>
                        ${item.weakness_summary}
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem;">
                        <span style="color: var(--apple-secondary);">累積修正: <strong>${item.occurred_count}</strong> 次</span>
                        <span style="color: ${statusColor}; font-weight: bold;">${statusText} (歸類: ${item.loss_reason})</span>
                    </div>
                </div>
            `;
            container.appendChild(el);
        });
    } catch(e) {
        console.error('Timeline 載入失敗', e);
        document.getElementById('timelineContainer').innerHTML = '<div class="empty-state">⚠️ 載入時間軸失敗。</div>';
    }
}
